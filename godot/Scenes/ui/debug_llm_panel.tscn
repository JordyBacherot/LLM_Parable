[node name="BtnRoomX1" type="Button" parent="MainPanel/HSplit/Left/ActionsScroll/VBox"]
layout_mode = 2
text = "2. Générer Pièce [1, 0, 0]"

[node name="BtnStairs" type="Button" parent="MainPanel/HSplit/Left/ActionsScroll/VBox"]
layout_mode = 2
text = "3. Générer Escalier [0, 1, 0]"

[node name="BtnSpawnCube" type="Button" parent="MainPanel/HSplit/Left/ActionsScroll/VBox"]
layout_mode = 2
