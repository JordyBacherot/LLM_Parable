[node name="VBox" type="VBoxContainer" parent="MainPanel/HSplit/Left/ActionsScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="BtnRoomZ1" type="Button" parent="MainPanel/HSplit/Left/ActionsScroll/VBox"]
layout_mode = 2
