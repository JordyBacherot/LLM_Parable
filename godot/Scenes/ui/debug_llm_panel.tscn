[node name="BtnDespawnCube" type="Button" parent="MainPanel/HSplit/Left/ActionsScroll/VBox"]
layout_mode = 2
text = "5. Faire Disparaître Cube"

[node name="BtnToggleDoor" type="Button" parent="MainPanel/HSplit/Left/ActionsScroll/VBox"]
