[gd_scene format=3 uid="uid://cdbgui001llm"]

[ext_resource type="Script" path="res://scripts/ui/debug_llm_panel.gd" id="1_debug_script"]

[node name="DebugLLMPanel" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_debug_script")

[node name="ToggleBtn" type="Button" parent="."]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -160.0
offset_top = 10.0
offset_right = -10.0
offset_bottom = 45.0
grow_horizontal = 0
